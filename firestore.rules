rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Avis clients : tout visiteur peut DÉPOSER un avis en attente ; seuls les avis validés sont lisibles.
    match /reviews/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'rating', 'text', 'status'])
                    && request.resource.data.status == 'pending'
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 800;
      allow read: if resource.data.status == 'approved';
      allow update, delete: if false;   // validation uniquement depuis la console Firebase (admin)
    }
    match /{document=**} { allow read, write: if false; }
  }
}
